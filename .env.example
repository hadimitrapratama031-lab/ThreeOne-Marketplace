# ============ Wajib ============
# Koneksi MongoDB (Railway MongoDB / MongoDB Atlas / lokal)
MONGODB_URI=mongodb://127.0.0.1:27017/marketplace

# Kunci penanda sesi login admin. Minimal 32 karakter acak. WAJIB di production.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# Admin pertama dibuat otomatis saat server hidup bila koleksi admins masih kosong.
# Password minimal 10 karakter. Setelah login, ganti dari menu Akun Admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ============ Cloudflare R2 (penyimpanan gambar) ============
# Dashboard Cloudflare -> R2 -> Manage API Tokens (izin: Object Read & Write pada bucket ini)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL PUBLIK bucket tanpa garis miring akhir. Production: custom domain (mis. https://cdn.domainmu.com).
# r2.dev hanya untuk uji coba (dibatasi laju oleh Cloudflare). JANGAN isi dengan endpoint *.r2.cloudflarestorage.com.
R2_PUBLIC_URL=

# ============ Opsional ============
# PORT diisi otomatis oleh Railway. Lokal default 3000.
# PORT=3000
# NODE_ENV=production            # Railway: isi production
# SESSION_DAYS=7                 # lama sesi login admin
# SEED_DEMO=true                 # isi data contoh dari prototype saat database KOSONG (aman diulang). Hapus setelah deploy pertama.
# CORS_ORIGINS=https://toko.domainmu.com   # hanya bila Marketplace dihosting di domain berbeda dari server ini (pisahkan koma)
# TRUST_PROXY=1                  # jumlah proxy di depan server (Railway = 1, sudah default di production)
# R2_ENDPOINT=                   # default dibentuk dari R2_ACCOUNT_ID
# R2_FORCE_PATH_STYLE=false      # true hanya untuk S3 lokal (MinIO) saat pengembangan
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017   # DB untuk npm test (dibuat & dihapus otomatis)
# MAX_VIDEO_MB=500                # batas ukuran per file video (upload manual & unduh otomatis trailer Steam). Default 500 MB;
                                   # ini katup keamanan memori proses, bukan batas kualitas Steam — naikkan bila Railway/R2 mendukung.

# ============ Live Chat ============
# Aktif/nonaktif, nomor WhatsApp admin, dan jeda notifikasi diatur di Admin Web -> Live Chat -> Pengaturan Live Chat.
# Notifikasi memakai Fonnte yang sama dengan notifikasi pesanan (token diatur di Admin Web -> Integrasi).
# Percakapan aktif 24 jam sejak dibuat (waktu server). Setelah expired, riwayat + gambar R2 disimpan sekian hari lalu dihapus otomatis.
# LIVECHAT_RETENTION_DAYS=7      # 0 = hapus segera setelah expired

# ============ Pembayaran QRIS (KlikQRIS) ============
# API Key, Merchant ID, mode Sandbox/Production, dan nomor WhatsApp Admin diatur di Admin Web -> Penjualan -> Pembayaran
# (API Key disimpan terenkripsi di MongoDB memakai APP_SECRET; jangan ganti APP_SECRET tanpa menyimpan ulang API Key).
# Webhook KlikQRIS:  https://DOMAIN-ANDA/api/payments/klikqris/webhook   (juga dikirim sebagai callback_url tiap transaksi)
# PUBLIC_BASE_URL=https://toko.domainmu.com   # opsional: domain publik untuk webhook & tautan Email/WhatsApp bila di belakang proxy lain
# DEFAULT_PUBLIC_ORIGIN=https://www.31store.site   # cadangan tautan notifikasi bila alamat publik tidak diketahui (default production: https://www.31store.site)
# KLIKQRIS_BASE_URL=https://klikqris.com/api  # default; hanya diubah untuk uji otomatis

# ============ Email (Resend) & WhatsApp (Fonnte) ============
# Diatur dari Admin Web -> Integrasi -> Email & WhatsApp (disimpan terenkripsi di MongoDB).
# Variabel di bawah HANYA cadangan bila Admin Web belum diisi (sama seperti project lama); nilai Admin Web selalu didahulukan.
# FONNTE_TOKEN=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@domaintoko.com   # wajib domain toko yang terverifikasi di Resend (bukan Gmail/Yahoo)
# RESEND_FROM_NAME=
# RESEND_REPLY_TO=
# RESEND_WEBHOOK_SECRET=
# Webhook status email (opsional): https://DOMAIN-ANDA/api/webhooks/resend

# ============ Discord (notifikasi pembayaran ke channel + DM Live Chat ke admin) ============
# Diatur dari Admin Web -> Integrasi -> Discord (token disimpan terenkripsi di MongoDB, tidak pernah dikirim ke browser).
# Variabel di bawah HANYA nilai awal bila Admin Web belum mengisi; nilai Admin Web selalu didahulukan. Semuanya opsional.
# Saklar "Aktifkan" tetap dari Admin Web: mengisi ENV saja tidak mengaktifkan pengiriman.
# Bot memakai REST API Discord (tanpa gateway): tidak ada proses bot terpisah di Railway, tidak perlu port/worker tambahan.
# Izin bot di channel tujuan: View Channel, Send Messages, Embed Links.
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_CHANNEL_ID=
# DISCORD_ADMIN_USER_ID=   # akun admin penerima DM Live Chat; admin harus satu server dengan bot dan mengizinkan DM dari anggota server

# ============ Migrasi dari project lama (hanya dipakai scripts/migrate-from-old.js; lihat scripts/README.md) ============
# OLD_MONGODB_URI=mongodb+srv://user:pass@host/?appName=...   # connection string database LAMA
# OLD_MONGODB_DB=test        # nama database lama. Project lama yang URI-nya tanpa nama database menyimpan datanya di "test"
# OLD_R2_ACCOUNT_ID=         # R2 lama: salin dari R2_* di .env project lama
# OLD_R2_ACCESS_KEY_ID=
# OLD_R2_SECRET_ACCESS_KEY=
# OLD_R2_BUCKET_NAME=
# OLD_R2_PUBLIC_URL=         # opsional (cadangan unduh lewat URL bila API R2 lama gagal)
