# ============ Wajib ============
# Koneksi MongoDB (Railway MongoDB / MongoDB Atlas / lokal)
MONGODB_URI=mongodb://127.0.0.1:27017/marketplace

# Kunci penanda sesi login admin. Minimal 32 karakter acak. WAJIB di production.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# Admin pertama dibuat otomatis saat server hidup bila koleksi admins masih kosong.
# Password minimal 10 karakter. Setelah login, ganti dari menu Akun Admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ============ Cloudflare R2 (penyimpanan gambar) ============
# Dashboard Cloudflare -> R2 -> Manage API Tokens (izin: Object Read & Write pada bucket ini)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL PUBLIK bucket tanpa garis miring akhir. Production: custom domain (mis. https://cdn.domainmu.com).
# r2.dev hanya untuk uji coba (dibatasi laju oleh Cloudflare). JANGAN isi dengan endpoint *.r2.cloudflarestorage.com.
R2_PUBLIC_URL=

# ============ Opsional ============
# PORT diisi otomatis oleh Railway. Lokal default 3000.
# PORT=3000
# NODE_ENV=production            # Railway: isi production
# SESSION_DAYS=7                 # lama sesi login admin
# SEED_DEMO=true                 # isi data contoh dari prototype saat database KOSONG (aman diulang). Hapus setelah deploy pertama.
# CORS_ORIGINS=https://toko.domainmu.com   # hanya bila Marketplace dihosting di domain berbeda dari server ini (pisahkan koma)
# TRUST_PROXY=1                  # jumlah proxy di depan server (Railway = 1, sudah default di production)
# R2_ENDPOINT=                   # default dibentuk dari R2_ACCOUNT_ID
# R2_FORCE_PATH_STYLE=false      # true hanya untuk S3 lokal (MinIO) saat pengembangan
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017   # DB untuk npm test (dibuat & dihapus otomatis)

# ============ Pembayaran QRIS (KlikQRIS) ============
# API Key, Merchant ID, mode Sandbox/Production, dan nomor WhatsApp Admin diatur di Admin Web -> Penjualan -> Pembayaran
# (API Key disimpan terenkripsi di MongoDB memakai APP_SECRET; jangan ganti APP_SECRET tanpa menyimpan ulang API Key).
# Webhook KlikQRIS:  https://DOMAIN-ANDA/api/payments/klikqris/webhook   (juga dikirim sebagai callback_url tiap transaksi)
# PUBLIC_BASE_URL=https://toko.domainmu.com   # opsional: domain publik untuk webhook bila di belakang proxy lain
# KLIKQRIS_BASE_URL=https://klikqris.com/api  # default; hanya diubah untuk uji otomatis

# ============ Email (Resend) & WhatsApp (Fonnte) ============
# Diatur dari Admin Web -> Integrasi -> Email & WhatsApp (disimpan terenkripsi di MongoDB).
# Variabel di bawah HANYA cadangan bila Admin Web belum diisi (sama seperti project lama); nilai Admin Web selalu didahulukan.
# FONNTE_TOKEN=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@domaintoko.com   # wajib domain toko yang terverifikasi di Resend (bukan Gmail/Yahoo)
# RESEND_FROM_NAME=
# RESEND_REPLY_TO=
# RESEND_WEBHOOK_SECRET=
# Webhook status email (opsional): https://DOMAIN-ANDA/api/webhooks/resend

# ============ Sistem Code (Order Code Redeem) ============
# Opsional. Kunci rahasia (min 24 karakter) agar SISTEM REDEEM Anda bisa menandai code sebagai "Redeemed" lewat
#   POST https://DOMAIN-ANDA/api/redeem/consume   header: x-redeem-key: <kunci>   body: {"code":"XXXX-XXXX"}
# Kosong = endpoint dimatikan (Admin tetap bisa menandai manual dari halaman Laporan Code).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REDEEM_API_KEY=
