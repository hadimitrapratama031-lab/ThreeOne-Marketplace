{
  "name": "marketplace-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Marketplace + Admin Web + Backend (Express, MongoDB, Cloudflare R2, Socket.IO)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed/run.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "reset:data": "node scripts/reset-data.js",
    "migrate:old": "node scripts/migrate-from-old.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
